<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Corre la sincronización Bear → blog cada 15 minutos. Ver docs/bear-blog.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gastoncorbalan.bear-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/Code/portfolio" &amp;&amp; git checkout -q main &amp;&amp; git pull -q --rebase &amp;&amp; npm run -s bear:publish</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/bear-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bear-sync.log</string>
</dict>
</plist>
